# ==============================================================================
# MediKiosk — Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
#
# IMPORTANT: NEVER commit your actual .env file or real secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Application & Server Settings
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
APP_SECRET=replace_with_a_secure_random_64_character_hex_string_for_production
LOG_LEVEL=debug
LOG_REDACT_PII=true

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL + Prisma)
# ------------------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://medikiosk_user:medikiosk_secure_password@localhost:5432/medikiosk_db?schema=public

# ------------------------------------------------------------------------------
# 3. Authentication & JWT Security
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace_with_a_very_long_random_jwt_access_secret_key_32bytes
JWT_REFRESH_SECRET=replace_with_a_very_long_random_jwt_refresh_secret_key_32bytes
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
KIOSK_SESSION_TTL_MINUTES=20
KIOSK_INACTIVITY_TIMEOUT_SECONDS=60

# ------------------------------------------------------------------------------
# 4. File Upload & Storage Settings
# ------------------------------------------------------------------------------
UPLOAD_STORAGE_DRIVER=local # Options: local | s3
LOCAL_UPLOAD_DIR=./storage/uploads
MAX_FILE_SIZE_MB=15
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf
FILE_ENCRYPTION_KEY=replace_with_32_byte_base64_encoded_aes_key

# ------------------------------------------------------------------------------
# 5. AI Service Sidecars & Model Endpoints
# ------------------------------------------------------------------------------
# Enable mock AI providers for zero-GPU local development and CI testing
MOCK_AI_SERVICES=false

# LLM Provider (Qwen2.5-7B-Instruct via vLLM / Ollama)
LLM_PROVIDER=qwen_local # Options: qwen_local | mock
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
LLM_API_KEY=not_required_for_local_vllm
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.1
LLM_REQUEST_TIMEOUT_MS=15000

# Speech-to-Text (ASR - AI4Bharat IndicConformer)
ASR_PROVIDER=indic_conformer # Options: indic_conformer | mock
ASR_ENDPOINT_URL=http://localhost:8001/transcribe
ASR_REQUEST_TIMEOUT_MS=10000

# Text-to-Speech (TTS - AI4Bharat IndicF5)
TTS_PROVIDER=indic_f5 # Options: indic_f5 | mock
TTS_ENDPOINT_URL=http://localhost:8002/synthesize
TTS_REQUEST_TIMEOUT_MS=8000

# OCR Provider (PaddleOCR PP-OCRv4)
OCR_PROVIDER=paddleocr # Options: paddleocr | mock
OCR_ENDPOINT_URL=http://localhost:8003/ocr
OCR_REQUEST_TIMEOUT_MS=20000

# ------------------------------------------------------------------------------
# 6. Real-Time Triage & WebSocket Settings
# ------------------------------------------------------------------------------
WS_PORT=5001
TRIAGE_ALERT_BROADCAST_CHANNEL=triage:alerts:critical

# ------------------------------------------------------------------------------
# 7. External Integrations & ABDM (Mock / Sandbox)
# ------------------------------------------------------------------------------
ABDM_ENABLED=false
ABDM_GATEWAY_URL=https://dev.abdm.gov.in/gateway
ABDM_CLIENT_ID=mock_abdm_client_id
ABDM_CLIENT_SECRET=mock_abdm_client_secret
