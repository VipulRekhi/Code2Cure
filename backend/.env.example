NODE_ENV=development
PORT=5000
# Supabase Transaction Pooler URL (e.g. postgresql://postgres.[project]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true)
DATABASE_URL=postgresql://medikiosk_user:medikiosk_secure_password@localhost:5432/medikiosk_db?schema=public
# Supabase Direct Connection URL for Migrations (e.g. postgresql://postgres.[project]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres)
DIRECT_URL=postgresql://medikiosk_user:medikiosk_secure_password@localhost:5432/medikiosk_db?schema=public
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string_for_production
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

# AI Model Configuration (Phase 4 Qwen 2.5 7B Instruct)
AI_PROVIDER=qwen
AI_MODE=mock # 'qwen' for local Ollama/vLLM runtime | 'mock' for CI / zero-GPU
AI_MODEL=qwen2.5:7b-instruct
AI_BASE_URL=http://localhost:11434/v1
AI_TIMEOUT_MS=8000

# Voice & OCR Pipeline Configuration (Port Isolation: ASR=8001, OCR=8002, TTS=8003)
ASR_PROVIDER=indicconformer
ASR_MODE=indicconformer
ASR_URL=http://127.0.0.1:8001
ASR_ENDPOINT=http://127.0.0.1:8001/asr
ASR_TIMEOUT_MS=10000

OCR_URL=http://127.0.0.1:8002
OCR_ENDPOINT=http://127.0.0.1:8002/ocr
OCR_PORT=8002

TTS_PROVIDER=neural-tts
TTS_MODE=neural-tts
TTS_URL=http://127.0.0.1:8003
TTS_ENDPOINT=http://127.0.0.1:8003/tts
TTS_PORT=8003
TTS_TIMEOUT_MS=12000
TTS_MARATHI_PROVIDER=mr-IN-AarohiNeural / facebook/mms-tts-mar
TTS_HINDI_PROVIDER=hi-IN-SwaraNeural / facebook/mms-tts-hin
TTS_ENGLISH_PROVIDER=en-IN-NeerjaNeural / facebook/mms-tts-eng
